  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "npm@11.21.0",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
