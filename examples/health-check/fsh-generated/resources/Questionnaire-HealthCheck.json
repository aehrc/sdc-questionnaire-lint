{
  "resourceType": "Questionnaire",
  "id": "HealthCheck",
  "status": "draft",
  "title": "Adult health check",
  "extension": [
    {
      "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-itemPopulationContext",
      "valueExpression": { "name": "observations", "language": "application/x-fhir-query", "expression": "Observation?patient={{%patient.id}}&code=29463-7,8302-2" }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": { "name": "age", "language": "text/fhirpath", "expression": "today().toDate() - %patient.birthDate" }
    },
    {
      "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-launchContext",
      "extension": [
        { "url": "name", "valueCoding": { "system": "http://hl7.org/fhir/uv/sdc/CodeSystem/launchContext", "code": "patient" } },
        { "url": "type", "valueCode": "Patient" }
      ]
    }
  ],
  "item": [
    {
      "linkId": "body",
      "type": "group",
      "text": "Body measurements",
      "item": [
        {
          "linkId": "weight",
          "type": "decimal",
          "text": "Weight (kg)",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": { "language": "text/fhirpath", "expression": "%observations.where(code.coding.code = '29463-7').value.value" }
            }
          ]
        },
        {
          "linkId": "height",
          "type": "decimal",
          "text": "Height (cm)",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/variable",
              "valueExpression": { "name": "heights", "language": "application/x-fhir-query", "expression": "%observations.where(code.coding.code = '8302-2')" }
            },
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
              "valueExpression": { "language": "text/fhirpath", "expression": "%heights.last().value.value" }
            }
          ]
        },
        {
          "linkId": "bmi",
          "type": "decimal",
          "text": "BMI",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/variable",
              "valueExpression": { "name": "h", "language": "text/fhirpath", "expression": "%resource.item.where(linkId = 'body').item.where(linkId = 'height').answer.fist().value / 100" }
            },
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
              "valueExpression": {
                "language": "text/fhirpath",
                "expression": "(%resource.item.where(linkId = 'body').item.where(linkId = 'weight').answer.value\r\n  / (%h * %h)).round(1"
              }
            }
          ]
        }
      ]
    },
    {
      "linkId": "smoking",
      "type": "choice",
      "text": "Do you smoke?",
      "extension": [
        {
          "url": "http://hl7.org/fhir/StructureDefinition/variable",
          "valueExpression": { "name": "smokingStatus", "language": "application/x-fhir-query", "expression": "Observation?patient={{%patient.id}}&code=72166-2&date=ge{{(today() - 1 year}}" }
        }
      ],
      "_text": {
        "extension": [
          {
            "url": "http://hl7.org/fhir/StructureDefinition/cqf-expression",
            "valueExpression": { "language": "text/fhirpath", "expression": "'Hello ' + %patient.name.given.first() + \", do you smoke?\"" }
          }
        ]
      },
      "answerOption": [
        { "valueString": "Yes" },
        {
          "valueString": "Former smoker",
          "extension": [
            {
              "url": "http://example.org/StructureDefinition/option-enabled",
              "valueExpression": { "language": "text/fhirpath", "expression": "%age > 18" }
            }
          ]
        }
      ]
    },
    {
      "linkId": "packs",
      "type": "integer",
      "text": "Packs per day",
      "extension": [
        {
          "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-enableWhenExpression",
          "valueExpression": { "language": "text/fhirpath", "expression": "%resource.item.where(linkId = 'smoking').answer.value = 'Yes' and" }
        }
      ]
    }
  ]
}
