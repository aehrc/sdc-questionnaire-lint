{
  "name": "sdc-questionnaire-lint",
  "version": "0.1.0",
  "description": "Static checks for FHIRPath and x-fhir-query expressions in FHIR SDC Questionnaires",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
