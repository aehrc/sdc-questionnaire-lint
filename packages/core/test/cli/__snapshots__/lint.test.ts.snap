// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`expression rule output > prints sdc/parse-error as text 1`] = `
"fsh-generated/resources/Questionnaire-Expressions.json: error sdc/parse-error A closing ) is missing.
  (%weight / (%height * %height)
                                ^
  location: compiled JSON; Questionnaire/Expressions; /item/0/extension/0/valueExpression/expression
  note: FSH line not found, no FSH sources are available
  note: the FHIRPath parser reported: missing ')' at '<EOF>'
  help: add ) at the end of the expression"
`;

exports[`expression rule output > prints sdc/unregistered-expression as text 1`] = `
"fsh-generated/resources/Questionnaire-Expressions.json: info sdc/unregistered-expression This expression is in a place the linter does not recognise, so only its FHIRPath syntax was checked.
  %age > 16
  location: compiled JSON; Questionnaire/Expressions; /item/1/answerOption/0/extension/0/valueExpression/expression
  note: FSH line not found, no FSH sources are available"
`;

