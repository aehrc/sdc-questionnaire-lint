{
  "resourceType": "Questionnaire",
  "id": "Invalid",
  "extension": [
    {
      "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-launchContext",
      "extension": [
        {
          "url": "name",
          "valueCoding": {
            "code": "patient",
            "system": "http://hl7.org/fhir/uv/sdc/CodeSystem/launchContext"
          }
        },
        {
          "url": "type",
          "valueCode": "Patient"
        }
      ]
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "observations",
        "language": "application/x-fhir-query",
        "expression": "%patient.id"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "recent",
        "language": "application/x-fhir-query",
        "expression": "Observation?patient={{%patient.id}}&date=ge{{(today() - 1 year}}"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "smoker",
        "language": "text/fhirpath",
        "expression": "%resource.item.where(linkId = 'smoker').answer.fist().value"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "packs",
        "language": "text/fhirpath",
        "expression": "%resource.item.where(linkId = 'pack').answer.value"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "yearsSmoked",
        "language": "text/fhirpath",
        "expression": "%resource.item.where(linkId = 'years').answer.value"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "packYears",
        "language": "text/fhirpath",
        "expression": "%packs * %smokingYears"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "smokingYears",
        "language": "text/fhirpath",
        "expression": "%packYears / %packs"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "yearsSmoked",
        "language": "text/fhirpath",
        "expression": "%resource.item.where(linkId = 'years').answer.value.first()"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "context",
        "language": "text/fhirpath",
        "expression": "%resource.item.where(linkId = 'smoker')"
      }
    }
  ],
  "item": [
    {
      "linkId": "smoker",
      "type": "boolean",
      "text": "Do you smoke?"
    },
    {
      "extension": [
        {
          "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-enableWhenExpression",
          "valueExpression": {
            "language": "text/fhirpath",
            "expression": "%smoker = true and"
          }
        }
      ],
      "linkId": "packs",
      "type": "integer",
      "text": "Packs per day"
    },
    {
      "extension": [
        {
          "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-enableWhenExpression",
          "valueExpression": {
            "language": "text/x-fhir-query",
            "expression": "Observation?patient={{%patient.id}}&code=72166-2"
          }
        }
      ],
      "linkId": "years",
      "type": "integer",
      "text": "Years smoked"
    },
    {
      "extension": [
        {
          "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
          "valueExpression": {
            "language": "text/fhirpath",
            "expression": "%packYears"
          }
        }
      ],
      "linkId": "pack-years",
      "type": "decimal",
      "text": "Pack-years",
      "readOnly": true
    },
    {
      "extension": [
        {
          "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
          "valueExpression": {
            "language": "text/fhirpath",
            "expression": "%context.exists()"
          }
        }
      ],
      "linkId": "context-check",
      "type": "boolean",
      "text": "Context check",
      "readOnly": true
    },
    {
      "extension": [
        {
          "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
          "valueExpression": {
            "language": "text/fhirpath",
            "expression": "%observations.total"
          }
        }
      ],
      "linkId": "smoking-records",
      "type": "integer",
      "text": "Smoking status records",
      "readOnly": true
    },
    {
      "extension": [
        {
          "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
          "valueExpression": {
            "language": "text/fhirpath",
            "expression": "%recnet.total"
          }
        }
      ],
      "linkId": "recent-records",
      "type": "integer",
      "text": "Observations in the last year",
      "readOnly": true
    },
    {
      "extension": [
        {
          "url": "http://hl7.org/fhir/StructureDefinition/variable",
          "valueExpression": {
            "name": "quitDate",
            "language": "text/fhirpath",
            "expression": "%resource.item.where(linkId = 'cessation').answer.value"
          }
        },
        {
          "url": "http://hl7.org/fhir/StructureDefinition/variable",
          "valueExpression": {
            "name": "smoker",
            "language": "text/fhirpath",
            "expression": "%resource.item.where(linkId = 'smoker').answer.value.first()"
          }
        },
        {
          "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-enableWhenExpression",
          "valueExpression": {
            "language": "text/fhirpath",
            "expression": "%smoker = false"
          }
        }
      ],
      "linkId": "cessation",
      "type": "date",
      "text": "Date you stopped smoking"
    },
    {
      "extension": [
        {
          "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
          "valueExpression": {
            "language": "text/cql",
            "reference": "http://example.org/Library/cessation-advice"
          }
        }
      ],
      "linkId": "advice",
      "type": "string",
      "text": "Cessation advice",
      "readOnly": true
    },
    {
      "extension": [
        {
          "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
          "valueExpression": {
            "language": "text/fhir-path",
            "expression": "'No notes'"
          }
        }
      ],
      "linkId": "notes",
      "type": "string",
      "text": "Notes"
    },
    {
      "linkId": "summary",
      "type": "string",
      "text": "Summary",
      "readOnly": true,
      "extension": [
        {
          "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpresion",
          "valueExpression": {
            "language": "text/fhirpath",
            "expression": "iif(%smoker, 'Smoker', 'Non-smoker')"
          }
        }
      ]
    }
  ],
  "status": "draft"
}
