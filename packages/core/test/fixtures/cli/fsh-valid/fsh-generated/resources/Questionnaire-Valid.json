{
  "resourceType": "Questionnaire",
  "id": "Valid",
  "extension": [
    {
      "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-launchContext",
      "extension": [
        {
          "url": "name",
          "valueCoding": {
            "code": "patient",
            "system": "http://hl7.org/fhir/uv/sdc/CodeSystem/launchContext"
          }
        },
        {
          "url": "type",
          "valueCode": "Patient"
        }
      ]
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "observations",
        "language": "application/x-fhir-query",
        "expression": "Observation?patient={{%patient.id}}&code=72166-2"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "recent",
        "language": "application/x-fhir-query",
        "expression": "Observation?patient={{%patient.id}}&date=ge{{today() - 1 year}}"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "smoker",
        "language": "text/fhirpath",
        "expression": "%resource.item.where(linkId = 'smoker').answer.first().value"
      }
    }
  ],
  "item": [
    {
      "linkId": "smoker",
      "type": "boolean",
      "text": "Do you smoke?"
    },
    {
      "extension": [
        {
          "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-enableWhenExpression",
          "valueExpression": {
            "language": "text/fhirpath",
            "expression": "%smoker = true"
          }
        }
      ],
      "linkId": "packs",
      "type": "integer",
      "text": "Packs per day"
    },
    {
      "extension": [
        {
          "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
          "valueExpression": {
            "language": "text/fhirpath",
            "expression": "%observations.total"
          }
        }
      ],
      "linkId": "smoking-records",
      "type": "integer",
      "text": "Smoking status records",
      "readOnly": true
    },
    {
      "extension": [
        {
          "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
          "valueExpression": {
            "language": "text/fhirpath",
            "expression": "%recent.total"
          }
        }
      ],
      "linkId": "recent-records",
      "type": "integer",
      "text": "Observations in the last year",
      "readOnly": true
    }
  ],
  "status": "draft"
}
